{
    "_comment": "Enhanced Minecraft Paper Hibernation Egg with MariaDB Integration",
    "meta": {
        "version": "PTDL_v2",
        "update_url": null
    },
    "exported_at": "2025-09-27",
    "name": "Minecraft: Paper (Hibernation Enhanced)",
    "author": "forked-by-you @ enhanced-hibernation",
    "description": "Minecraft Paper server with hibernation: sleeps on idle, wakes on connect. Enhanced with MariaDB logging and auto-backups.",
    "features": null,
    "docker_images": {
        "ghcr.io/parkervcp/yolks:debian": "ghcr.io/parkervcp/yolks:debian"
    },
    "file_denylist": [],
    "startup": "node index.js {{SERVER_MEMORY}} {{SERVER_JARFILE}}",
    "config": {
        "files": {},
        "startup": [
            {
                "key": "hibernate_timeout",
                "default": "300",
                "label": "Timeout inattività (secondi)",
                "type": "number",
                "description": "Tempo prima del sleep (default 5 min)."
            },
            {
                "key": "mssql_host",
                "default": "",
                "label": "MariaDB Host",
                "type": "text",
                "description": "Host del DB (es. localhost o mariadb.yourhost.com)."
            },
            {
                "key": "mssql_username",
                "default": "",
                "label": "MariaDB User",
                "type": "text",
                "description": "Username DB."
            },
            {
                "key": "mssql_password",
                "default": "",
                "label": "MariaDB Password",
                "type": "password",
                "description": "Password DB."
            },
            {
                "key": "mssql_database",
                "default": "pterodactyl",
                "label": "MariaDB Database",
                "type": "text",
                "description": "Nome DB (usa quello di Pterodactyl)."
            },
            {
                "key": "server_id",
                "default": "{{SERVER_UUID}}",
                "label": "Server ID",
                "type": "text",
                "description": "ID univoco per logs DB."
            },
            {
                "key": "discord_webhook",
                "default": "",
                "label": "Discord Webhook (opzionale)",
                "type": "text",
                "description": "Per notifiche sleep/wake."
            }
        ],
        "logs": {},
        "stop": "^C"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\napt update\napt install -y nodejs npm default-jre\nnpm ci\nnpm install mariadb axios\n# Crea table se non esiste (usa env vars)\nnode setup-db.js\n",
            "container": "ghcr.io/parkervcp/yolks:debian",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "key": "hibernate_timeout",
            "type": "number",
            "default": 300
        },
        {
            "key": "mssql_host",
            "type": "text",
            "default": ""
        },
        {
            "key": "mssql_username",
            "type": "text",
            "default": ""
        },
        {
            "key": "mssql_password",
            "type": "password",
            "default": ""
        },
        {
            "key": "mssql_database",
            "type": "text",
            "default": "pterodactyl"
        },
        {
            "key": "server_id",
            "type": "text",
            "default": "{{SERVER_UUID}}"
        },
        {
            "key": "discord_webhook",
            "type": "text",
            "default": ""
        }
    ]
}
